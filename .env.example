# mohallaMitr Environment Configuration

# Backend (apps/backend/.env)
# See apps/backend/.env.example for all backend variables

# Mobile App (.env in apps/mobile/)
EXPO_PUBLIC_API_URL=http://localhost:5001
EXPO_PUBLIC_ENABLE_SOCKET=true
EXPO_PUBLIC_SOCKET_URL=http://localhost:5001

# Web App (.env.local in apps/web/)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5001
