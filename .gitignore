# .gitignore

# Dependencies
node_modules/
*.pem
package-lock.json
# yarn.lock is intentionally tracked for reproducible EAS cloud builds
.pnp
.pnp.js

# Testing
coverage/
*.lcov
.nyc_output/

# Production
build/
dist/
.next
out/
*.tsbuildinfo

# Misc
.env
.env.local
.env.*.local
.DS_Store
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Log files
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Editor directories and files
.vscode
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Expo
.expo/
.expo-shared/
dist/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# iOS
ios/Pods/
ios/*.xcodeproj/xcuserdata
ios/*.xcworkspace

# Android
android/build
android/app/build
android/app/src/main/gen
android/keystore

# IDE
.eslintcache
.stylelintcache

# Environment
.env
.env.*.local

# Temporary files
*.tmp
*.temp
tmp/
temp/

# AI assistant tool cache & state directories (not application code)
.agent/
.amazonq/
.augment/
.bob/
.claude/
.cline/
.clinerules/
.codebuddy/
.codex/
.continue/
.cospec/
.crush/
.cursor/
.factory/
.forge/
.gemini/
.iflow/
.junie/
.kilocode/
.kiro/
.lingma/
.opencode/
.pi/
.qoder/
.qwen/
.roo/
.trae/
.windsurf/

# Generated specification artifacts (local, per-branch)
# Keep .github/ and .specify/ — they're shared configuration
openspec/
specs/
