# Misc
.env
.env.local
.env.*.local
.DS_Store
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Log files
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Editor directories and files
.vscode
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Expo
.expo/
.expo-shared/
dist/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# iOS
ios/Pods/
ios/*.xcodeproj/xcuserdata
ios/*.xcworkspace

# Android
android/build
android/app/build
android/app/src/main/gen
android/keystore

# IDE
