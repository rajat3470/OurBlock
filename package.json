{
  "name": "mohallamitr-monorepo",
  "version": "1.0.0",
  "description": "mohallaMitr - Local Society Marketplace Platform (Monorepo)",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "mobile": "yarn workspace @mohallamitr/mobile start",
    "mobile:customer": "yarn workspace @mohallamitr/mobile start:user",
    "mobile:business": "yarn workspace @mohallamitr/mobile start:business-owner",
    "mobile:ios": "yarn workspace @mohallamitr/mobile ios",
    "mobile:android": "yarn workspace @mohallamitr/mobile android",
    "web": "yarn workspace @mohallamitr/web dev",
    "firebase:serve": "yarn workspace @ourblock/firebase serve",
    "firebase:deploy": "yarn workspace @ourblock/firebase deploy",
    "lint": "yarn workspaces run lint",
    "type-check": "yarn workspaces run type-check",
    "clean": "yarn workspaces run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  },
  "dependencies": {
    "expo": "~55.0.19",
    "react": "19.2.0",
    "react-native": "0.83.6"
  }
}
