{
  "name": "ourblock-monorepo",
  "version": "1.0.0",
  "description": "OurBlock - Local Society Marketplace Platform (Monorepo)",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "yarn workspace @ourblock/mobile start",
    "mobile:customer": "yarn workspace @ourblock/mobile start:user",
    "mobile:business": "yarn workspace @ourblock/mobile start:business-owner",
    "mobile:ios": "yarn workspace @ourblock/mobile ios",
    "mobile:android": "yarn workspace @ourblock/mobile android",
    "web": "yarn workspace @ourblock/web dev",
    "firebase:serve": "yarn workspace @ourblock/firebase serve",
    "firebase:deploy": "yarn workspace @ourblock/firebase deploy",
    "lint": "yarn workspaces run lint",
    "type-check": "yarn workspaces run type-check",
    "clean": "yarn workspaces run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  }
}
