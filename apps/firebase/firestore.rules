rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // The mobile app currently authenticates through its own REST API and does
    // not sign in to Firebase Auth. Until Firebase Auth is integrated, allow
    // public read access to the collections consumed by the real-time snapshot
    // listeners. All mutations are performed by Firebase Functions, so client
    // writes remain denied.
    match /businesses/{businessId} {
      allow read: if true;
    }

    match /products/{productId} {
      allow read: if true;
    }

    match /societies/{societyId} {
      allow read: if true;
    }

    match /banners/{bannerId} {
      allow read: if true;
    }

    match /orders/{orderId} {
      allow read: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
