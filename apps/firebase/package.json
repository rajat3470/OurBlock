{
  "name": "@mohallamitr/firebase",
  "version": "1.0.0",
  "description": "mohallaMitr Firebase Backend (Cloud Functions & Configuration)",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "serve": "cd functions && npm run build && cd .. && firebase emulators:start",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "cd functions && npm run build && cd .. && firebase deploy --only functions",
    "logs": "firebase functions:log",
    "build": "cd functions && npm run build",
    "lint": "cd functions && npm run lint",
    "type-check": "cd functions && tsc --noEmit",
    "clean": "rm -rf functions/lib functions/node_modules node_modules"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@mohallamitr/shared": "*",
    "cors": "^2.8.5",
    "express": "^4.19.0",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.29.0",
    "firebase-functions-test": "^3.3.0",
    "typescript": "^5.4.0"
  }
}
