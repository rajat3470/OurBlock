# Database — MongoDB Atlas (or local MongoDB for development)
MONGODB_URI="mongodb://localhost:27017/mohallamitr"
# Example Atlas URI:
# MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/mohallamitr?retryWrites=true&w=majority"

# Server
PORT=5001
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="30d"

# Super admin email allowlist (comma-separated, fallback role grant)
SUPER_ADMIN_EMAILS="ankushrishi5@gmail.com"

# Dev-only mock token bypass (mirrors legacy Firebase mock tokens). Set to
# "false" in production to disable entirely.
ENABLE_MOCK_AUTH=true

# S3-compatible object storage (works with AWS S3, Cloudflare R2, or local MinIO)
# For local MinIO:
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="mohallamitr"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL="http://localhost:9000/mohallamitr"

# For AWS S3 in production (ap-south-1, bucket mohallmitr):
# S3_ENDPOINT=""
# S3_REGION="ap-south-1"
# S3_BUCKET="mohallmitr"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL="https://mohallmitr.s3.ap-south-1.amazonaws.com"

# OneSignal push notifications
ONESIGNAL_APP_ID=""
ONESIGNAL_API_KEY=""

# CORS
CORS_ORIGIN="*"
