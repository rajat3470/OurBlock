# ─────────────────────────────────────────────────────────────────────────────
# mohallaMitr Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local, .env.int, or .env.prod and fill in your values.
# Then run: yarn env:local | yarn env:int | yarn env:prod
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5001

# ── Database ─────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/mohallamitr
# Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/mohallamitr?retryWrites=true&w=majority
MONGODB_URI=

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# ── Auth ─────────────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAILS=ankushrishi5@gmail.com
ENABLE_MOCK_AUTH=true

# ── S3 Storage ───────────────────────────────────────────────────────────────
# Local MinIO:  endpoint=http://localhost:9000, key/secret=minioadmin, pathStyle=true
# AWS S3:       endpoint= (leave empty), region=ap-south-1, pathStyle=false
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=

# ── Push Notifications ───────────────────────────────────────────────────────
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=*
