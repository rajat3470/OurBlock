# mohallaMitr — production environment for self-contained EC2 deployment
# Copy this file to /var/www/mohallamitr/apps/backend/.env (and apps/web/.env.local)
# and replace every placeholder before starting the services.

NODE_ENV=production
PORT=5001

# ---------------------------------------------------------------------------
# MongoDB — self-contained EC2 stack uses the local Docker Compose MongoDB.
# For managed production, swap to MongoDB Atlas.
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://mongo:mongo@127.0.0.1:27017/mohallamitr?authSource=admin
# Atlas example:
# MONGODB_URI=mongodb+srv://mohallamitr_app:<PASS>@cluster0.xxxxx.mongodb.net/mohallamitr?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# JWT secrets — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=CHANGE_ME_64_BYTE_HEX_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_64_BYTE_HEX_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# ---------------------------------------------------------------------------
# Super-admin allowlist (comma-separated)
# ---------------------------------------------------------------------------
SUPER_ADMIN_EMAILS=ankushrishi5@gmail.com,admin@yourdomain.com

# ---------------------------------------------------------------------------
# Auth — disable mock-token bypass in production.
# ---------------------------------------------------------------------------
ENABLE_MOCK_AUTH=false

# ---------------------------------------------------------------------------
# S3-compatible object storage — self-contained stack uses local MinIO.
# For managed production, swap to AWS S3 or Cloudflare R2.
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=mohallamitr
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=https://YOUR_DOMAIN_OR_IP/uploads
# AWS S3 example:
# S3_ENDPOINT=
# S3_REGION=ap-south-1
# S3_BUCKET=mohallamitr-prod-uploads
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=https://mohallamitr-prod-uploads.s3.ap-south-1.amazonaws.com

# ---------------------------------------------------------------------------
# OneSignal push notifications
# ---------------------------------------------------------------------------
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ---------------------------------------------------------------------------
# CORS — lock to your actual domains. "*" is acceptable only for quick demos.
# ---------------------------------------------------------------------------
CORS_ORIGIN=https://YOUR_DOMAIN

# ---------------------------------------------------------------------------
# Feature flags (optional)
# ---------------------------------------------------------------------------
FF_ADS_ENABLED=false
FF_ADS_NATIVE_FEED_ENABLED=false
FF_ADS_NATIVE_LISTING_ENABLED=false
FF_ADS_REWARDED_ENABLED=false
FF_ADS_REWARDED_MIN_RS=2
FF_ADS_REWARDED_MAX_RS=5
FF_ADS_DENSITY_EVERY_NTH_CARD=4
FF_ADS_REWARDED_MAX_CLAIMS_PER_DAY=1
