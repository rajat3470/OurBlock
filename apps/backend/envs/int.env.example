# mohallaMitr Backend — INTEGRATION (Atlas DB + AWS S3, local server)

NODE_ENV=development
PORT=5001

# ── Database (MongoDB Atlas) ─────────────────────────────────────────────────
MONGODB_URI=<paste-your-atlas-uri>

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=<paste-your-jwt-access-secret>
JWT_REFRESH_SECRET=<paste-your-jwt-refresh-secret>
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# ── Auth ─────────────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAILS=ankushrishi5@gmail.com
ENABLE_MOCK_AUTH=true

# ── S3 Storage (AWS S3) ──────────────────────────────────────────────────────
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=mohallmitr
S3_ACCESS_KEY_ID=<paste-your-s3-access-key>
S3_SECRET_ACCESS_KEY=<paste-your-s3-secret-key>
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=https://mohallmitr.s3.ap-south-1.amazonaws.com

# ── Push Notifications ───────────────────────────────────────────────────────
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=*
