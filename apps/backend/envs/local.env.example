# mohallaMitr Backend — LOCAL (localhost everything)

NODE_ENV=development
PORT=5001

# ── Database (local MongoDB) ─────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/mohallamitr

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-local-access-secret
JWT_REFRESH_SECRET=change-me-local-refresh-secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# ── Auth ─────────────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAILS=ankushrishi5@gmail.com
ENABLE_MOCK_AUTH=true

# ── S3 Storage (local MinIO) ─────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mohallamitr
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/mohallamitr

# ── Push Notifications (disabled locally) ─────────────────────────────────────
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=*
