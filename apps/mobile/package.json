{
  "name": "@mohallamitr/mobile",
  "version": "1.0.0",
  "description": "mohallaMitr Mobile App (Customer & Business Owner)",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:business-owner": "EXPO_PUBLIC_APP_TARGET=businessOwner expo start",
    "start:user": "EXPO_PUBLIC_APP_TARGET=user expo start",
    "start:delivery-partner": "EXPO_PUBLIC_APP_TARGET=deliveryPartner expo start",
    "start:business-owner:ios": "EXPO_PUBLIC_APP_TARGET=businessOwner expo start --ios",
    "start:business-owner:android": "EXPO_PUBLIC_APP_TARGET=businessOwner expo start --android",
    "start:user:ios": "EXPO_PUBLIC_APP_TARGET=user expo start --ios",
    "start:user:android": "EXPO_PUBLIC_APP_TARGET=user expo start --android",
    "start:delivery-partner:ios": "EXPO_PUBLIC_APP_TARGET=deliveryPartner expo start --ios",
    "start:delivery-partner:android": "EXPO_PUBLIC_APP_TARGET=deliveryPartner expo start --android",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "test:smoke": "node scripts/smoke-app-targets.cjs",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf node_modules .expo android/app/build ios/build"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@mohallamitr/shared": "1.0.0",
    "@hookform/resolvers": "^3.3.4",
    "@react-native-async-storage/async-storage": "2.2.0",

    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/stack": "^6.3.20",
    "@reduxjs/toolkit": "^1.9.7",
    "axios": "^1.6.5",
    "date-fns": "^2.30.0",
    "expo": "^55.0.27",
    "expo-audio": "~55.0.15",
    "expo-blur": "^55.0.14",
    "expo-build-properties": "~55.0.15",
    "expo-camera": "~55.0.16",
    "expo-dev-client": "~55.0.36",
    "expo-device": "~55.0.17",
    "expo-font": "~55.0.6",
    "expo-image": "~55.0.9",
    "expo-image-manipulator": "^55.0.16",
    "expo-image-picker": "^55.0.20",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.14",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.5",

    "lodash": "^4.17.21",
    "onesignal-expo-plugin": "2.7.0",
    "react": "19.2.0",
    "react-hook-form": "^7.48.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-google-mobile-ads": "^13.4.0",
    "react-native-modal": "^13.0.1",
    "react-native-onesignal": "5.2.14",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-toast-notifications": "^3.3.1",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "react-redux": "^8.1.3",
    "socket.io-client": "^4.7.2",
    "zod": "^3.22.4",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.5",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@testing-library/react-native": "^12.4.2",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.6",
    "@types/react": "~19.2.10",
    "eslint": "^8.55.0",
    "eslint-config-expo": "~55.0.0",
    "jest": "^29.7.0",
    "typescript": "^5.3.3"
  }
}
