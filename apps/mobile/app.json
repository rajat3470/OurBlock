{
  "expo": {
    "name": "OurBlock",
    "slug": "ourblock",
    "scheme": "ourblock", 
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.ourblock.app"
    },
    "android": {
      "package": "com.ourblock.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-image",
      "expo-router"
    ]
  }
}
