# OurBlock Mobile App - Environment Configuration

# Production API (deployed Firebase Functions)
EXPO_PUBLIC_API_BASE_URL=https://us-central1-our-block-app.cloudfunctions.net/api

# Firebase Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyAc44Eb_Pktk2eiaYS9NGQTdeURTrDRHZQ
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=our-block-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=our-block-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=our-block-app.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1007523518094
EXPO_PUBLIC_FIREBASE_APP_ID=1:1007523518094:web:90f70ec3c56b108fd49bdf

# Courier — push notification routing
# Client key is safe to ship in the mobile bundle (read-only, scoped to inbox + token registration)
# Get from: Courier Dashboard → Settings → API Keys → Client Key
EXPO_PUBLIC_COURIER_CLIENT_KEY=your-courier-client-key-here

# OneSignal — push notifications
# Get App ID from: OneSignal Dashboard → Settings → Keys & IDs
EXPO_PUBLIC_ONESIGNAL_APP_ID=fcea43c1-bf78-4299-b784-940c3f0f4fe1

# WebSocket real-time updates
# EXPO_PUBLIC_ENABLE_SOCKET=true
# EXPO_PUBLIC_SOCKET_URL=https://your-socket-server.example.com
# EXPO_PUBLIC_SOCKET_PATH=/socket.io

# Optional: For local development with emulators
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5001/our-block-app/us-central1/api
# EXPO_PUBLIC_USE_EMULATOR=true
