# ─────────────────────────────────────────────────────────────────────────────
# mohallaMitr Mobile — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local, .env.int, or .env.prod and fill in your values.
# Then run: yarn env:local | yarn env:int | yarn env:prod
#
# Only EXPO_PUBLIC_* vars are bundled into the app.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ──────────────────────────────────────────────────────────────────────
# Local:  http://localhost:5001  (or http://<your-ip>:5001 for physical device)
# Prod:   https://mohallamitr.in/api
EXPO_PUBLIC_API_BASE_URL=

# ── WebSocket ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_ENABLE_SOCKET=true
EXPO_PUBLIC_SOCKET_URL=

# ── Push Notifications ───────────────────────────────────────────────────────
EXPO_PUBLIC_ONESIGNAL_APP_ID=

# ── Firebase (analytics/crashlytics only — auth is JWT-based) ────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
