# mohallaMitr Mobile App - Environment Configuration

# Backend API URL
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5001

# OneSignal — push notifications
# Get App ID from: OneSignal Dashboard → Settings → Keys & IDs
EXPO_PUBLIC_ONESIGNAL_APP_ID=313b06ab-d2b4-4225-93cf-fe7c9db37f6d

# WebSocket real-time updates
EXPO_PUBLIC_ENABLE_SOCKET=true
EXPO_PUBLIC_SOCKET_URL=http://127.0.0.1:5001
EXPO_PUBLIC_SOCKET_PATH=/socket.io
